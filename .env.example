# Copia este archivo a .env.local (desarrollo) o configura estas variables en tu hosting.

# Usuario del panel /admin
ADMIN_USER=Admin
# Genera el hash con: npm run hash-password -- "<contraseña>"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres para firmar la sesión
SESSION_SECRET=

# Postgres (Neon, Supabase, Vercel Postgres…). Si se omite, se usa PGlite en ./.data/pglite
# DATABASE_URL=
# Carpeta alternativa para PGlite (servidor propio con disco persistente)
# PGLITE_DIR=
