# Copia este archivo a .env.local (desarrollo) o configura estas variables en tu hosting.

# Usuario del panel /admin
ADMIN_USER=Admin
# Genera el hash con: npm run hash-password -- "<contraseña>"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres para firmar la sesión
SESSION_SECRET=

# Postgres (Neon, Supabase, Vercel Postgres…). Si se omite, se usa PGlite en ./.data/pglite
# DATABASE_URL=
# Carpeta alternativa para PGlite (servidor propio con disco persistente)
# PGLITE_DIR=

# ---------- Pagos con Stripe ----------
# Llave secreta: Dashboard de Stripe → Developers → API keys (sk_test_… para pruebas, sk_live_… en producción)
STRIPE_SECRET_KEY=
# Secreto del webhook https://<tu-dominio>/api/stripe/webhook (eventos checkout.session.completed,
# checkout.session.async_payment_succeeded y charge.refunded). En local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=
# Dominio público con el que se arman las ligas de pago que se envían al huésped (sin / al final)
SITE_URL=https://www.haciendadelindiohotel.com
